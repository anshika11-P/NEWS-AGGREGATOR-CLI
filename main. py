import argparse
from news_fetcher import fetch_news
from storage import save_news, load_news
from filters import filter_news
from export_news import export_news


def show_news(news):
    if not news:
        print("No news found!")
        return

    for i, item in enumerate(news, 1):
        print(f"\n{i}. {item['title']}")
        print("Source:", item['source'])
        print("Date:", item['published'])
        print("Link:", item['link'])


def main():

    while True:
        print("\n===== NEWS AGGREGATOR CLI =====")
        print("1. Fetch Latest News")
        print("2. View Saved News")
        print("3. Search News")
        print("4. Filter by Source")
        print("5. Filter by Date")
        print("6. Export News")
        print("7. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            news = fetch_news()
            count = save_news(news)
            print("News fetched:", len(news))
            print("New articles saved:", count)

        elif choice == "2":
            show_news(load_news())

        elif choice == "3":
            keyword = input("Enter keyword: ")
            show_news(filter_news(load_news(), keyword=keyword))

        elif choice == "4":
            source = input("Enter source: ")
            show_news(filter_news(load_news(), source=source))

        elif choice == "5":
            date_text = input("Enter date (YYYY-MM-DD): ")
            show_news(filter_news(load_news(), date=date_text))

        elif choice == "6":
            news = load_news()

            if news:
                file_type = input("Enter csv or excel: ").lower()

                try:
                    result = export_news(news, file_type)
                    print("Export successful:", result)
                except ValueError as error:
                    print(error)
            else:
                print("No news available!")

        elif choice == "7":
            print("Thank you!")
            break

        else:
            print("Invalid choice!")


if __name__ == "__main__":
    main()